# ──────────────────────────────────────────────────────────────────────────────
# AI Mentor — Backend Environment Variables
# Copy this file to .env  (never commit .env to git)
# ──────────────────────────────────────────────────────────────────────────────

# Anthropic API key  (required)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# JWT signing secret  (required – must be at least 32 characters)
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
